{
  "name": "@decisionly-incorporated/mastercom-extended-api-client",
  "version": "1.0.0",
  "description": "Generated Mastercom Extended API client",
  "type": "commonjs",
  "main": "dist/api.js",
  "types": "dist/api.d.ts",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Decisionly-Incorporated/mastercom_extended_api_client.git"
  },
  "exports": {
    ".": {
      "types": "./dist/api.d.ts",
      "default": "./dist/api.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "clean": "tsc --clean",
    "test": "echo \"no tests\" && exit 0"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.13.4",
    "@types/node": "^20.14.2",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "dropin-request": "^1.1.1"
  }
}
